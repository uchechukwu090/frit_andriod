<?xml version="1.0" encoding="utf-8"?>
<!-- Play-ready (targetSdk 35): same excludes for cloud + device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="frit_prefs.xml" />
        <exclude domain="sharedpref" path="frit_secure.xml" />
        <exclude domain="sharedpref" path="frit_veil.xml" />
        <exclude domain="sharedpref" path="frit_veil_face.xml" />
        <exclude domain="sharedpref" path="frit_trading_cache.xml" />
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="frit_prefs.xml" />
        <exclude domain="sharedpref" path="frit_secure.xml" />
        <exclude domain="sharedpref" path="frit_veil.xml" />
        <exclude domain="sharedpref" path="frit_veil_face.xml" />
        <exclude domain="sharedpref" path="frit_trading_cache.xml" />
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
